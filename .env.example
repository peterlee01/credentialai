# Optional: emails new facility sign-ups and intro requests to info@credentialai.co (resend.com)
RESEND_API_KEY=
# Optional: physician and facility accounts (Supabase project settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
